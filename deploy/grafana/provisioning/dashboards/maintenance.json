{
  "annotations": {
    "list": []
  },
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Requests per second",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "4xx responses",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status_code=~\"4..\"}[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "5xx responses",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status_code=~\"5..\"}[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "API availability",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "up{job=\"maintenance-api\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN"
                },
                "1": {
                  "text": "UP"
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Request duration",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Total requests",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(http_requests_total)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "table",
      "title": "Requests by status",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT status, COUNT(*)::int AS request_count FROM maintenance_requests GROUP BY status ORDER BY request_count DESC",
          "refId": "A"
        }
      ]
    },
    {
      "type": "table",
      "title": "Requests by priority",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT priority, COUNT(*)::int AS request_count FROM maintenance_requests GROUP BY priority ORDER BY request_count DESC",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Average close time (hours)",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT ROUND(AVG(EXTRACT(EPOCH FROM (rsh.changed_at - mr.\"createdAt\")) / 3600)::numeric, 2) AS average_close_hours FROM maintenance_requests mr JOIN request_status_history rsh ON rsh.request_id = mr.id WHERE mr.status = 'done' AND rsh.new_status = 'done'",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h"
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Equipment load",
      "gridPos": {
        "h": 6,
        "w": 16,
        "x": 8,
        "y": 20
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT e.name AS equipment, COUNT(mr.id)::int AS request_count, COUNT(mr.id) FILTER (WHERE mr.status = 'done')::int AS closed_count, COALESCE(SUM(ra.hours), 0)::numeric AS planned_hours FROM equipment e LEFT JOIN maintenance_requests mr ON mr.equipment_id = e.id LEFT JOIN request_assignees ra ON ra.request_id = mr.id GROUP BY e.id, e.name ORDER BY request_count DESC",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": [
    "maintenance",
    "case4"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "title": "Maintenance API",
  "uid": "maintenance-api",
  "version": 1
}